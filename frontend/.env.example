# .env.example
# -----------------------------------------------------------------------
# Ce fichier est un MODÈLE. Pour l'utiliser :
#   1. Copiez-le en le renommant ".env" (à la racine du projet)
#   2. Adaptez l'adresse ci-dessous à celle de votre serveur Laravel
#
# Vite lit automatiquement le fichier ".env" et rend ces variables
# disponibles dans le code via import.meta.env.VITE_XXX (voir
# src/services/api.js). Seules les variables commençant par VITE_
# sont accessibles côté frontend, pour des raisons de sécurité.
# -----------------------------------------------------------------------

VITE_API_URL=/api
VITE_BACKEND_URL=http://localhost:8000

# Identifiant client OAuth Web à créer dans Google Cloud Console.
# Utilisez le même identifiant dans GOOGLE_CLIENT_ID du fichier .env Laravel.
VITE_GOOGLE_CLIENT_ID=
